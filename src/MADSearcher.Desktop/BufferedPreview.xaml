<UserControl x:Class="MADSearcher.Desktop.BufferedPreview"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:MADSearcher.Desktop"
 Focusable="True" PreviewKeyDown="PreviewKey" PreviewMouseDown="PreviewClicked"
 Loaded="PreviewLoaded" Unloaded="PreviewUnloaded">
 <StackPanel>
  <Border Height="218" Margin="0,10,0,6" ClipToBounds="True">
   <Border.Background>
    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
     <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#18232D" Geometry="M0,0 H20 V20 H0 Z" />
      <GeometryDrawing Brush="#293640" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z" />
     </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
   </Border.Background>
   <Grid>
    <Image x:Name="Picture" Stretch="Uniform" />
    <Border x:Name="LoadingBadge" Background="#CB101923" VerticalAlignment="Bottom" Padding="8,5">
     <TextBlock x:Name="LoadingText" Text="尚未载入画面" Foreground="#E4EEF4" TextWrapping="Wrap" FontSize="11" />
    </Border>
   </Grid>
  </Border>
  <TextBlock x:Name="PositionLabel" Text="00:00:00 · 无声画面预览" Foreground="#BACCD6" FontSize="11" Margin="0,2,0,6" />
  <local:FrameTimeline x:Name="Timeline" />
  <WrapPanel Margin="0,7,0,0">
   <Button x:Name="PlayButton" Content="▶ 播放" Click="TogglePlayback" />
   <Button Content="◀ 帧" Click="PreviousFrame" ToolTip="上一帧（左方向键）" />
   <Button Content="帧 ▶" Click="NextFrame" ToolTip="下一帧（右方向键）" />
   <Button Content="＋" Click="ZoomIn" ToolTip="放大时间线" />
   <Button Content="－" Click="ZoomOut" ToolTip="缩小时间线" />
   <Button Content="全片" Click="ShowAll" />
   <Button Content="重试加载" Click="Retry" />
  </WrapPanel>
  <WrapPanel x:Name="MarkControls" Visibility="Collapsed">
   <Button x:Name="StartButton" Content="设为开始 [I]" Click="MarkStart" />
   <Button x:Name="EndButton" Content="设为结束 [O]" Click="MarkEnd" ToolTip="保留当前帧；后端终点为下一帧边界" />
   <Button Content="回到起点" Click="GoToStart" />
  </WrapPanel>
  <TextBlock x:Name="SelectionLabel" Foreground="#9BC8F4" FontSize="11" TextWrapping="Wrap" />
  <TextBlock x:Name="BufferLabel" Text="青色：已缓存 · 蓝色：抠像范围 · 空格播放/暂停" Foreground="#8AA5B5" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
 </StackPanel>
</UserControl>
